#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/dist"
rm -rf "$build_dir"
mkdir -p "$build_dir"
cp index.html styles.css tokens.css app.js mascotas.js "$build_dir/"
cp -R assets "$build_dir/assets"
cp -R fonts "$build_dir/fonts"
cp -R data lib "$build_dir/"

[[ -d "$build_dir" ]] || {
  echo "Expected build output at $build_dir" >&2
  exit 1
}
figma make deploy-preview --build-dir "$build_dir"
