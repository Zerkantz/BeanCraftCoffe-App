#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/dist"
rm -rf "$build_dir"
mkdir -p "$build_dir"
cp index.html styles.css app.js "$build_dir/"
cp -R assets "$build_dir/assets"

[[ -d "$build_dir" ]] || {
  echo "Expected build output at $build_dir" >&2
  exit 1
}
figma make deploy --build-dir "$build_dir"
